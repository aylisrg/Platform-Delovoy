# Database
DATABASE_URL="postgresql://delovoy:delovoy_secret@localhost:5432/delovoy_park"
POSTGRES_PASSWORD="delovoy_secret"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
# Для production: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="dev-secret-change-in-production"

# NOTE: Yandex/Google OAuth providers were removed in Wave 1 of the auth
# refactor (ADR 2026-04-27 §8). Telegram bot deep-link + VK ID v2 + email
# magic-link are the supported sign-in methods going forward. Other Yandex
# integrations (Maps, Metrika, Direct, Business) are unrelated and remain
# below.

# VK ID v2 OAuth (https://dev.vk.com/ru/admin/apps-list)
# Redirect URI для производства: https://<domain>/api/auth/callback/vk-id
VK_CLIENT_ID="your-vk-app-id"
VK_CLIENT_SECRET="your-vk-app-secret"
# VK Community Messages (уведомления через сообщество ВКонтакте)
# Токен сообщества с правом messages — vk.com/club<id> → Управление → Работа с API
VK_COMMUNITY_TOKEN="your-vk-community-token"
# Числовой ID сообщества (без минуса, например: 12345678)
VK_COMMUNITY_ID="your-vk-community-id"

# Green API — WhatsApp (https://green-api.com/)
GREENAPI_URL="https://api.green-api.com"
GREENAPI_INSTANCE_ID="your-instance-id"
GREENAPI_TOKEN="your-api-token"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_ADMIN_CHAT_ID="your-admin-group-id"
# Личный chat_id владельца для СРОЧНО-обращений (получить: написать @userinfobot)
TELEGRAM_OWNER_CHAT_ID="your-personal-chat-id"
# Обходные пути, если api.telegram.org недоступен с сервера (RU-блокировка /
# сетевой сбой). Диагностика: workflow "Telegram Diagnose", runbook в DEPLOYMENT.md.
# HTTP(S) CONNECT-прокси только для Telegram-трафика, напр. http://user:pass@host:3128.
# SOCKS не поддерживается — используйте TELEGRAM_API_ROOT-релей.
TELEGRAM_PROXY_URL=""
# Альтернативный корень Bot API (Cloudflare Worker-релей, nginx-релей или
# локальный Bot API server), без завершающего слэша: https://tg-relay.example.com
TELEGRAM_API_ROOT=""
# Имя бота для Telegram Login Widget (без @) — DEPRECATED, будет удалено
# через 30 дней после раскатки нового deep-link flow (ADR 2026-04-27 §10).
NEXT_PUBLIC_TELEGRAM_BOT_NAME="your_bot_name"
# Имя бота (без @) для нового /api/auth/telegram/start — строит ссылку
# https://t.me/<this>?start=auth_<token>. Wave 2.
TELEGRAM_BOT_USERNAME="DelovoyPark_bot"
# Shared secret для server-to-server вызова /api/internal/auth/bot-login-token
# из Telegram-бота (reverse bot→web login, ADR 2026-04-30).
# 32+ random bytes, ОДНО И ТО ЖЕ значение в web и bot контейнерах.
# Сгенерировать: openssl rand -hex 32
BOT_INTERNAL_SECRET=""
# Same value, but inlined into client bundle by Next.js. When unset, the
# signin page hides the "Войти через Telegram" button entirely (PRD AC-14).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="DelovoyPark_bot"
# Shared secret for the internal bot↔web login endpoint
# (POST /api/internal/auth/bot-login-token, ADR 2026-04-30). Must match
# across web and bot containers. Generate: openssl rand -hex 32.
# Leave empty to disable bot→web auto-login (graceful fallback to APP_URL).
BOT_INTERNAL_SECRET=""

# Google Calendar API (Service Account для синхронизации бронирований)
# Содержимое JSON-ключа service account (или путь к файлу)
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...@...iam.gserviceaccount.com"}'

# Release notifications (CI → Telegram для подписчиков)
# Для production: openssl rand -hex 32
RELEASE_NOTIFY_SECRET=""
# Gemini 2.5 Flash — авто-генерация release notes из git log (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Yandex Maps
YANDEX_MAPS_URL="https://yandex.ru/maps/-/CPrFnN9z"
NEXT_PUBLIC_YANDEX_MAPS_URL="https://yandex.ru/maps/-/CPrFnN9z"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@delovoy-park.ru"

# Avito API (реклама беседок — https://developers.avito.ru)
AVITO_CLIENT_ID=""
AVITO_CLIENT_SECRET=""
AVITO_ITEM_ID=""              # ID объявления беседок на Авито

# Yandex API (Директ + Метрика/Бизнес — https://oauth.yandex.ru)
YANDEX_OAUTH_TOKEN=""           # OAuth токен (единый для Директ и Метрики)
YANDEX_DIRECT_CLIENT_LOGIN=""   # Логин аккаунта Яндекс Директ
YANDEX_METRIKA_COUNTER_ID="73068007"  # ID счётчика Яндекс Метрики
# Баланс рекламного счёта в Директе через v5 API доступен только агентским токеном.
# Для прямого клиента можно задать баланс вручную (в рублях, обновляйте по факту):
YANDEX_DIRECT_BALANCE_MANUAL="" # Например: "12500.50"

# Novofon (виртуальная АТС — https://novofon.com)
# Настройка телефонии для беседок, PS Park и звонков/SMS из CRM арендаторов
NOVOFON_API_KEY=""              # API ключ от аккаунта Novofon
NOVOFON_WEBHOOK_SECRET=""       # HMAC-секрет для верификации вебхуков Novofon
NOVOFON_DEFAULT_SIP_LINE=""     # SIP-линия для прямых звонков из CRM (без бронирования), напр. 79161234567
NOVOFON_CALLER_ID=""            # Номер, отображаемый на экране получателя (виртуальный номер)

# Web Push (VAPID, RFC 8292) — канал уведомлений для администрирования.
# Сгенерировать пару: `npx web-push generate-vapid-keys --json`.
# По умолчанию OFF (WEB_PUSH_ENABLED=false): канал зарегистрирован как no-op,
# Dispatcher fallback'ит на следующий канал. Включается только когда выставлены
# все 4 переменные ниже + WEB_PUSH_ENABLED=true.
WEB_PUSH_ENABLED="false"
VAPID_PUBLIC_KEY=""             # base64url, ~87 символов
VAPID_PRIVATE_KEY=""            # base64url, ~43 символа (НИКОГДА не коммитить)
VAPID_SUBJECT="mailto:admin@delovoy-park.ru"  # mailto: или https://-URL
NEXT_PUBLIC_VAPID_PUBLIC_KEY="" # копия VAPID_PUBLIC_KEY для клиентского subscribe

# YooKassa (онлайн-оплата — https://yookassa.ru/developers)
# Тестовый и боевой магазины различаются только парой shopId/ключ.
YOOKASSA_SHOP_ID=""             # ЛК → Настройки → Магазин
YOOKASSA_SECRET_KEY=""          # ЛК → Интеграция → Ключи API (НИКОГДА не коммитить)
# Секретный сегмент URL вебхука: /api/payments/yookassa/webhook/<этот секрет>.
# Сгенерировать: openssl rand -hex 32. URL настраивается в ЛК → Интеграция →
# HTTP-уведомления (события: payment.succeeded, payment.waiting_for_capture,
# payment.canceled, refund.succeeded). Без секрета вебхук отвечает 503.
YOOKASSA_WEBHOOK_SECRET=""
# Чеки 54-ФЗ («Чеки от ЮKassa»): true после включения фискализации в ЛК.
# При true объект receipt обязателен в каждом платеже → у плательщика должен
# быть email или телефон.
YOOKASSA_RECEIPTS_ENABLED="false"
YOOKASSA_VAT_CODE="1"           # 1 = без НДС (уточнить у бухгалтерии)
# Reconciliation-cron (страховка от потери вебхука), каждые ~10 минут:
# */10 * * * * curl -s "https://<домен>/api/cron/payments-reconcile?token=$CRON_SECRET"
