# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/*.db
prisma/*.db-journal

# docker
docker-compose.override.yml

# user uploads (feedback screenshots, etc.)
uploads/
.claude/worktrees/

# Claude Code session runtime state — sessionId/pid/timestamp, rewritten by
# every session that touches the repo; never meant to be version-controlled
# (issue #479 — was causing spurious "uncommitted changes" + noise PRs, e.g. #542)
.claude/scheduled_tasks.lock

# debug scripts (temporary local debugging, never commit)
scripts/debug-*

# agent runtime state (stored in workspace volume on Hetzner)
.agent-state.json
.agent-logs/
