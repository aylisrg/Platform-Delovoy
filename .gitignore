# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — любые, кроме шаблонов *.example
.env*
!.env*.example

# логи и дампы БД (бэкап-скрипты пишут их локально)
*.log
*.sql.gz
*.dump

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/*.db
prisma/*.db-journal

# docker
docker-compose.override.yml

# user uploads (feedback screenshots, etc.)
/uploads/
.claude/worktrees/

# Claude Code session runtime state — sessionId/pid/timestamp, rewritten by
# every session that touches the repo; never meant to be version-controlled
# (issue #479 — was causing spurious "uncommitted changes" + noise PRs, e.g. #542)
.claude/scheduled_tasks.lock

# debug scripts (temporary local debugging, never commit)
scripts/debug-*
