{
  "name": "platform-delovoy",
  "version": "2.20.0",
  "description": "Platform Delovoy — business park management system",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "./scripts/dev-start.sh",
    "dev:docker": "docker compose -f docker-compose.dev.yml up -d",
    "dev:stop": "docker compose -f docker-compose.dev.yml down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update-snapshots": "playwright test visual-regression.spec.ts --update-snapshots",
    "build:e2e": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "agents:eval": "npx tsx eval/runner.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "bash scripts/pre-migration-backup.sh \"${MIGRATION_TAG:-$npm_package_version}\" && prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "npx tsx scripts/seed.ts",
    "setup:metrika": "node --env-file=.env --import tsx/esm scripts/setup-metrika-goals.ts",
    "setup:metrika-advanced": "node --env-file=.env --import tsx/esm scripts/setup-metrika-advanced.ts",
    "test:direct": "node --env-file=.env --import tsx/esm scripts/test-direct-api.ts",
    "setup:direct": "node --env-file=.env --import tsx/esm scripts/setup-direct-campaigns.ts",
    "clear-test-inventory": "npx tsx scripts/clear-test-inventory.ts",
    "analyze-errors": "tsx scripts/analyze-errors.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@twa-dev/sdk": "^8.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/nodemailer": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "framer-motion": "^13.1.1",
    "googleapis": "^176.0.0",
    "grammy": "^1.45.1",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "3.22.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^7.0.7",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.21.0",
    "undici": "^8.10.0",
    "web-push": "3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "xlsx": "^0.18.5"
  }
}
