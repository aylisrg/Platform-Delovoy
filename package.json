{
  "name": "platform-delovoy",
  "version": "2.28.0",
  "description": "Platform Delovoy — business park management system",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:full": "./scripts/dev-start.sh",
    "dev:docker": "docker compose -f docker-compose.dev.yml up -d",
    "dev:stop": "docker compose -f docker-compose.dev.yml down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.bot.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update-snapshots": "playwright test visual-regression.spec.ts --update-snapshots",
    "build:e2e": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "bash scripts/pre-migration-backup.sh \"${MIGRATION_TAG:-$npm_package_version}\" && prisma migrate deploy",
    "db:seed": "npx tsx scripts/seed.ts",
    "setup:metrika": "node --env-file=.env --import tsx/esm scripts/setup-metrika-goals.ts",
    "setup:metrika-advanced": "node --env-file=.env --import tsx/esm scripts/setup-metrika-advanced.ts",
    "test:direct": "node --env-file=.env --import tsx/esm scripts/test-direct-api.ts",
    "setup:direct": "node --env-file=.env --import tsx/esm scripts/setup-direct-campaigns.ts",
    "clear-test-inventory": "npx tsx scripts/clear-test-inventory.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "framer-motion": "^14.10.0",
    "googleapis": "^186.0.0",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "4.6.0",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^7.0.7",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "undici": "^8.12.4",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.5"
  }
}
