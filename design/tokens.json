{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Дизайн-токены лендинга «Деловой Парк». Тема light. Источник правды — канвас Claude Design (design/canvas) и этот файл; globals.css генерируется из него через @theme.",
  "color": {
    "surface": {
      "0": { "$type": "color", "$value": "#ffffff", "$description": "Страница, белые карточки, инпуты" },
      "1": { "$type": "color", "$value": "#f5f5f7", "$description": "Чередующиеся секции, серые карточки" },
      "2": { "$type": "color", "$value": "#e8e8ed", "$description": "Hover серых карточек, чипсы, фон под фото" },
      "inverse": { "$type": "color", "$value": "#1d1d1f", "$description": "Только тосты и тултипы" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#1d1d1f", "$description": "Заголовки, основной текст. 16.1:1 на белом" },
      "secondary": { "$type": "color", "$value": "#6e6e73", "$description": "Описания, подписи любого размера. 5.2:1 на белом, 4.7:1 на surface.1" },
      "tertiary": { "$type": "color", "$value": "#86868b", "$description": "Только текст от 15px и декоративные подписи (3.5:1 на белом)" },
      "onAccent": { "$type": "color", "$value": "#ffffff", "$description": "Текст на accent и модульных цветах" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#0071e3", "$description": "Кнопки, ссылки, фокус, выделенное слово в hero" },
      "hover": { "$type": "color", "$value": "#0077ed" },
      "active": { "$type": "color", "$value": "#0066cc" },
      "subtle": { "$type": "color", "$value": "rgba(0, 113, 227, 0.08)", "$description": "Фон иконок преимуществ, выделенная карточка" },
      "subtleBorder": { "$type": "color", "$value": "rgba(0, 113, 227, 0.12)" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "rgba(0, 0, 0, 0.04)", "$description": "Разделители секций, рамка белых карточек" },
      "default": { "$type": "color", "$value": "rgba(0, 0, 0, 0.08)", "$description": "Инпуты, явные рамки" },
      "strong": { "$type": "color", "$value": "rgba(0, 0, 0, 0.12)", "$description": "Hover рамок" }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "rgba(0, 113, 227, 0.24)", "$description": "3px, только :focus-visible" }
    },
    "module": {
      "rental": { "$type": "color", "$value": "#0071e3", "$description": "Офисы" },
      "gazebos": { "$type": "color", "$value": "#16a34a", "$description": "Барбекю Парк" },
      "psPark": { "$type": "color", "$value": "#7c3aed", "$description": "Плей Парк" },
      "cafe": { "$type": "color", "$value": "#ea580c", "$description": "Кафе" },
      "parking": { "$type": "color", "$value": "#0891b2", "$description": "Автостоянка" }
    },
    "rating": { "$type": "color", "$value": "#fbc02d", "$description": "Звёзды рейтинга" },
    "brand": {
      "yandex": { "$type": "color", "$value": "#fc3f1d" },
      "twoGis": { "$type": "color", "$value": "#00b140" },
      "telegram": { "$type": "color", "$value": "#229ed9" },
      "whatsapp": { "$type": "color", "$value": "#25d366" }
    },
    "status": {
      "success": { "$type": "color", "$value": "#16a34a" },
      "warning": { "$type": "color", "$value": "#d97706", "$description": "Бейдж «Сдан», индикатор «Все места заняты»" },
      "danger": { "$type": "color", "$value": "#dc2626" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Manrope", "Inter", "system-ui", "sans-serif"], "$description": "Заголовки, статистика, имена. Self-hosted src/app/fonts" },
      "body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600, "$description": "Максимум для заголовков; 700 не используется" }
    }
  },
  "typography": {
    "display": {
      "hero": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "96px", "lineHeight": 0.9, "letterSpacing": "-0.04em" }, "$extensions": { "delovoy.mobile": { "fontSize": "48px", "lineHeight": 0.92, "letterSpacing": "-2px" } } },
      "section": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "64px", "lineHeight": 1, "letterSpacing": "-0.03em" }, "$extensions": { "delovoy.mobile": { "fontSize": "40px", "lineHeight": 1, "letterSpacing": "-1.2px" } } }
    },
    "heading": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "32px", "lineHeight": 1.1, "letterSpacing": "-1px" }, "$extensions": { "delovoy.mobile": { "fontSize": "28px", "letterSpacing": "-0.8px" } } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "24px", "lineHeight": 1.15, "letterSpacing": "-0.5px" }, "$extensions": { "delovoy.mobile": { "fontSize": "22px" } } },
      "sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "20px", "lineHeight": 1.2, "letterSpacing": "-0.4px" }, "$extensions": { "delovoy.mobile": { "fontSize": "18px", "lineHeight": 1.25 } } },
      "xs": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "16px", "lineHeight": 1.3, "letterSpacing": "-0.3px" } }
    },
    "stat": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "40px", "lineHeight": 1.1, "letterSpacing": "-1.2px" }, "$description": "font-variant-numeric: tabular-nums", "$extensions": { "delovoy.mobile": { "fontSize": "32px", "letterSpacing": "-1px" } } },
    "body": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "18px", "lineHeight": 1.5 }, "$extensions": { "delovoy.mobile": { "fontSize": "17px" } } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "15px", "lineHeight": 1.6 } },
      "sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "14px", "lineHeight": 1.5 }, "$description": "Цвет только text.secondary, не tertiary" }
    },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "13px", "lineHeight": 1.4 } },
    "label": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 500, "fontSize": "12px", "lineHeight": 1.4, "letterSpacing": "0.3px" }, "$description": "Единственный uppercase в системе" },
    "button": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 500, "fontSize": "15px", "lineHeight": 1 } },
    "input": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "15px", "lineHeight": 1.5 }, "$extensions": { "delovoy.mobile": { "fontSize": "16px" } }, "$description": "16px на мобильных, чтобы iOS не зумил" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "section": { "$type": "dimension", "$value": "96px", "$description": "Вертикальный padding секции", "$extensions": { "delovoy.mobile": "64px" } },
    "headingToGrid": { "$type": "dimension", "$value": "56px", "$extensions": { "delovoy.mobile": "40px" } },
    "cardGap": { "$type": "dimension", "$value": "16px", "$description": "20px для крупных карточек услуг" },
    "cardPadding": { "$type": "dimension", "$value": "24px", "$extensions": { "delovoy.mobile": "20px" } }
  },
  "layout": {
    "container": { "$type": "dimension", "$value": "1200px" },
    "gutter": { "$type": "dimension", "$value": "24px", "$extensions": { "delovoy.mobile": "16px" } },
    "navbarHeight": { "$type": "dimension", "$value": "56px" },
    "touchTarget": { "$type": "dimension", "$value": "44px" },
    "breakpoint": {
      "sm": { "$type": "dimension", "$value": "640px" },
      "md": { "$type": "dimension", "$value": "768px" },
      "lg": { "$type": "dimension", "$value": "1024px" },
      "xl": { "$type": "dimension", "$value": "1280px" }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px", "$description": "Теги, маленькие иконки-плашки" },
    "md": { "$type": "dimension", "$value": "12px", "$description": "Инпуты, иконки преимуществ" },
    "lg": { "$type": "dimension", "$value": "16px", "$description": "Карточки, бейдж рейтинга" },
    "xl": { "$type": "dimension", "$value": "24px", "$description": "Панель листа ожидания, карта" },
    "full": { "$type": "dimension", "$value": "999px", "$description": "Кнопки, чипы, аватары" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": [{ "color": "rgba(0, 0, 0, 0.05)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }], "$description": "Белая карточка на surface.1" },
    "md": { "$type": "shadow", "$value": [{ "color": "rgba(0, 0, 0, 0.08)", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" }], "$description": "Hover бейджа, дропдаун" },
    "lg": { "$type": "shadow", "$value": [{ "color": "rgba(0, 0, 0, 0.12)", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" }], "$description": "Модалка, hover карточки услуги" }
  },
  "motion": {
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms", "$description": "Цвет, рамка, opacity" },
      "base": { "$type": "duration", "$value": "250ms", "$description": "Тень, сдвиг" },
      "reveal": { "$type": "duration", "$value": "500ms", "$description": "Появление секции при скролле: opacity 0→1, translateY 16→0, threshold 0.15, один раз" },
      "photo": { "$type": "duration", "$value": "500ms", "$description": "Hover фото: scale 1.04" }
    },
    "cardLift": { "$type": "dimension", "$value": "-4px", "$description": "translateY карточки на hover вместе с shadow.lg" },
    "reducedMotion": { "$type": "string", "$value": "opacity-only 150ms", "$description": "prefers-reduced-motion: без сдвигов и scale" }
  }
}
